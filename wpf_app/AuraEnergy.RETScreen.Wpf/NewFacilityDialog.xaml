<Window x:Class="AuraEnergy.RETScreen.Wpf.NewFacilityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Nový Areál a Energetický Projekt (RETScreen® Expert Facility Wizard)"
        Height="620" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#003366" Padding="14,10" CornerRadius="4" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="DomainPlus" Width="32" Height="32" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Založení nového areálu &amp; Energetického posudku" FontWeight="Bold" FontSize="15" Foreground="White" />
                    <TextBlock Text="Vyberte typ objektu / areálu, lokalitu a předdefinované archetypy z oficiální databáze RETScreen" FontSize="11" Foreground="#B0BEC5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Wizard -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Facility Type Selection -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="4" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="1. Typ areálu / Budovy:" FontWeight="Bold" FontSize="13" Foreground="#003366" Margin="0,0,0,8" />
                    <ListBox x:Name="listFacilityTypes" SelectionChanged="ListFacilityTypes_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <iconPacks:PackIconMaterial Kind="{Binding IconKind}" Width="20" Height="20" Foreground="{Binding IconColor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="Gray" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Panel: Parameters and Archetype Details -->
            <Border Grid.Column="2" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="4" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="2. Parametry areálu a lokace" FontWeight="Bold" FontSize="13" Foreground="#003366" Margin="0,0,0,10" />

                        <!-- Facility Name -->
                        <TextBlock Text="Název areálu / projektu:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                        <TextBox x:Name="txtFacilityName" Text="Nemocnice a poliklinika - Energetický audit 2026" Padding="6,4" FontSize="12" Margin="0,0,0,10" />

                        <!-- Location & Climate -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Město a stát:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <TextBox x:Name="txtLocationCity" Text="Praha, Česká republika" Padding="6,4" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Meteorologická stanice (WMO):" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <ComboBox x:Name="cmbMeteoStation" SelectedIndex="0" Padding="6,4" FontSize="12">
                                    <ComboBoxItem Content="11518 - Praha / Ruzyně (ČHMÚ &amp; NASA)" />
                                    <ComboBoxItem Content="11710 - Brno / Tuřany (ČHMÚ &amp; NASA)" />
                                    <ComboBoxItem Content="11782 - Ostrava / Mošnov (ČHMÚ &amp; NASA)" />
                                    <ComboBoxItem Content="11520 - Plzeň / Mikulka (ČHMÚ &amp; NASA)" />
                                    <ComboBoxItem Content="11457 - Ústí nad Labem (ČHMÚ &amp; NASA)" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Archetype Features -->
                        <TextBlock Text="3. Přednastavené energetické subsystémy:" FontWeight="Bold" FontSize="13" Foreground="#003366" Margin="0,6,0,8" />
                        
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="chkPv" Content="Fotovoltaika (FVE) - rezidenční 10 kWp / komerční" IsChecked="True" FontWeight="SemiBold" Margin="0,2" />
                                <CheckBox x:Name="chkBess" Content="Bateriové úložiště (BESS) - LFP / hybridní střídač" IsChecked="True" FontWeight="SemiBold" Margin="0,2" />
                                <CheckBox x:Name="chkHp" Content="Tepelné čerpadlo (TČ) / Klimatizace A+++" IsChecked="True" FontWeight="SemiBold" Margin="0,2" />
                                <CheckBox x:Name="chkRecup" Content="Centrální rekuperace &amp; řízené větrání (ZZT 88%)" IsChecked="True" FontWeight="SemiBold" Margin="0,2" />
                                <CheckBox x:Name="chkBoiler" Content="Kondenzační / peletový kotel &amp; elektrokotel" IsChecked="False" FontWeight="SemiBold" Margin="0,2" />
                                <CheckBox x:Name="chkChp" Content="Kogenerační jednotka (CHP) s KVET bonusem" IsChecked="False" FontWeight="SemiBold" Margin="0,2" />
                                <CheckBox x:Name="chkSolarThermal" Content="Solární termika pro ohřev TV" IsChecked="False" FontWeight="SemiBold" Margin="0,2" />
                                <CheckBox x:Name="chkEsg" Content="ESG CSRD Audit a E-Mobility nabíjecí wallbox" IsChecked="True" FontWeight="SemiBold" Margin="0,2" />
                            </StackPanel>
                        </Border>

                        <!-- Gross Floor Area & Project Life -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Užitná plocha areálu (m²):" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <TextBox x:Name="txtFloorArea" Text="12 500" Padding="6,4" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Životnost projektu (roky):" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <TextBox x:Name="txtProjectLife" Text="25" Padding="6,4" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <!-- Load Template Button -->
                        <Button x:Name="btnLoadNetZeroSample" Content="Načíst oficiální Net-Zero vzor RETScreen" Background="#F3F4F6" Foreground="#1F2937" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" FontWeight="SemiBold" Click="BtnLoadNetZeroSample_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Storno" Width="90" Height="30" Margin="0,0,10,0" Background="#E0E0E0" Click="BtnCancel_Click" />
                <Button Content="Vytvořit a otevřít areál" Width="180" Height="30" Background="#005A9E" Foreground="White" FontWeight="Bold" Click="BtnCreate_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
