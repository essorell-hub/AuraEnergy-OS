<fluent:RibbonWindow x:Class="AuraEnergy.RETScreen.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fluent="urn:fluent-ribbon"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:AuraEnergy.RETScreen.Wpf"
        mc:Ignorable="d"
        Title="AuraEnergy RETScreen® Expert Suite 2026 - Clean Energy Decision Support"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ================= MS FLUENT RIBBON (1:1 RETScreen Ribbon) ================= -->
        <fluent:Ribbon Grid.Row="0">
            <!-- Quick Access Items -->
            <fluent:Ribbon.QuickAccessItems>
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=btnSave}" />
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=btnCalculate}" />
            </fluent:Ribbon.QuickAccessItems>

            <!-- Application Menu (File / Backstage) -->
            <fluent:Ribbon.Menu>
                <fluent:Backstage Header="Soubor">
                    <fluent:BackstageTabControl>
                        <fluent:BackstageTabItem Header="Informace o projektu">
                            <StackPanel Margin="20">
                                <TextBlock Text="AuraEnergy RETScreen Expert Desktop" FontSize="20" FontWeight="Bold" Foreground="#003366" />
                                <TextBlock Text="Nativní Windows .NET 8 WPF edice s podporou .retx balíčků a 10 187 certifikovaných produktů." Margin="0,5,0,20" />
                                <fluent:Button x:Name="btnOpenRetx" Header="Otevřít oficiální RETScreen soubor (.retx)" Click="BtnOpenRetx_Click" Width="320" HorizontalAlignment="Left" />
                                <fluent:Button x:Name="btnSaveRetx" Header="Uložit jako RETScreen projekt (.retx)" Click="BtnSaveRetx_Click" Width="320" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </fluent:BackstageTabItem>
                    </fluent:BackstageTabControl>
                </fluent:Backstage>
            </fluent:Ribbon.Menu>

            <!-- TAB 1: FACILITY (LOKALITA) -->
            <fluent:RibbonTabItem Header="1. Lokalita (Facility)">
                <fluent:RibbonGroupBox Header="Správa areálu">
                    <fluent:Button Header="Nový Areál"  />
                    <fluent:Button x:Name="btnSave" Header="Uložit" Click="BtnSave_Click" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="Klimatická data NASA">
                    <fluent:Button Header="Vyhledat Stanici" Click="BtnSearchStation_Click" />
                    <fluent:Button Header="Stáhnout NASA POWER" Click="BtnNasaPower_Click" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 2: ENERGY (ENERGETICKÝ MODEL) -->
            <fluent:RibbonTabItem Header="2. Energie (Energy Model)">
                <fluent:RibbonGroupBox Header="Přidat OZE Subsystém">
                    <fluent:Button Header="Fotovoltaika (FVE)" Click="BtnAddPv_Click" />
                    <fluent:Button Header="Větrná turbína" Click="BtnAddWind_Click" />
                    <fluent:Button Header="Tepelné čerpadlo" Click="BtnAddHp_Click" />
                    <fluent:Button Header="Solární ohřev TUV" Click="BtnAddSolarThermal_Click" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="Energetické audity">
                    <fluent:Button Header="Osvětlení &amp; LED" />
                    <fluent:Button Header="Zateplení obálky" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 3: COST (NÁKLADY &amp; ROZPOČET WBS) -->
            <fluent:RibbonTabItem Header="3. Náklady (Cost WBS)">
                <fluent:RibbonGroupBox Header="Položkový rozpočet">
                    <fluent:Button Header="Přidat WBS položku" Click="BtnAddWbsItem_Click" />
                    <fluent:Button Header="Přepočet DPH a rezerv" Click="BtnRecalcWbs_Click" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="Dotace &amp; Podpora">
                    <fluent:Button Header="Uplatnit NZÚ / OP TAK" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 4: EMISSION (EMISE GHG) -->
            <fluent:RibbonTabItem Header="4. Emise (GHG Analysis)">
                <fluent:RibbonGroupBox Header="Kalkulace emisí">
                    <fluent:Button Header="Emisní faktor sítě ČR" />
                    <fluent:Button Header="Ekologické ekvivalenty" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 5: FINANCIAL (FINANČNÍ ANALÝZA &amp; RIZIKO) -->
            <fluent:RibbonTabItem Header="5. Finance &amp; Riziko (Financial &amp; Risk)">
                <fluent:RibbonGroupBox Header="Analýza návratnosti">
                    <fluent:Button x:Name="btnCalculate" Header="Spustit finanční kalkulaci" Click="BtnCalculate_Click" />
                    <fluent:Button Header="Export Manažerský PDF" Click="BtnExportPdf_Click" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="Analýza rizik">
                    <fluent:Button Header="Tornado Chart (±20 %)" Click="BtnTornado_Click" />
                    <fluent:Button Header="Monte Carlo Simulace" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 6: BENCHMARK &amp; TOOLS -->
            <fluent:RibbonTabItem Header="6. Benchmark &amp; VEA">
                <fluent:RibbonGroupBox Header="Hodnocení EUI">
                    <fluent:Button Header="5-Star Rating" />
                    <fluent:Button Header="Dekarbonizace 2030" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>
        </fluent:Ribbon>

        <!-- ================= MAIN WORKSPACE (TREEVIEW + SPREADSHEET + CHARTS) ================= -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEVÝ HIERARCHICKÝ STROM (RETScreen TreeView) -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#003366" Padding="8,6">
                        <TextBlock Text="PROJEKTOVÝ STROM A SUBSYSTÉMY" FontWeight="Bold" Foreground="White" FontSize="11" />
                    </Border>
                    <TreeView x:Name="treeProject" BorderThickness="0" Margin="4" SelectedItemChanged="TreeProject_SelectedItemChanged">
                        <TreeViewItem Header="Nemocnice s poliklinikou (Facility)" IsExpanded="True">
                            <TreeViewItem Header="Lokalita a klima (Praha NASA POWER)" IsSelected="True" />
                            <TreeViewItem Header="Zatížení areálu (End-Use Loads)" IsExpanded="True">
                                <TreeViewItem Header="Osvětlení &amp; LPD" />
                                <TreeViewItem Header="Vytápění &amp; VZT" />
                                <TreeViewItem Header="Chlazení &amp; Klimatizace" />
                            </TreeViewItem>
                            <TreeViewItem Header="Navržená energetická soustava" IsExpanded="True">
                                <TreeViewItem Header="FVE Elektrárna (monoSi 250 kWp)" />
                                <TreeViewItem Header="Tepelné čerpadlo (Země-Voda 120 kWt)" />
                                <TreeViewItem Header="BESS Bateriové úložiště (300 kWh)" />
                            </TreeViewItem>
                            <TreeViewItem Header="Položkový rozpočet (WBS CAPEX)" />
                            <TreeViewItem Header="Emisní bilance skleníkových plynů" />
                            <TreeViewItem Header="Finanční model (25leté cash flows)" />
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0" />

            <!-- HLAVNÍ PRACOVNÍ PLOCHA (Tabulkový procesor + Grafy) -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="300" />
                </Grid.RowDefinitions>

                <!-- HEADER LIŠTA ZVOLENÉHO FORMULÁŘE -->
                <Border Grid.Row="0" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" Padding="12,8" Margin="0,0,0,6" CornerRadius="3">
                    <Grid>
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="txtViewTitle" Text="Lokalita a klimatická data NASA POWER" FontSize="14" FontWeight="Bold" Foreground="#003366" />
                            <TextBlock x:Name="txtViewSubtitle" Text="Stanice: Praha / Ruzyne (50.08° N, 14.43° E, 230 m n.m.) | Globální horizontální ozáření GHI: 1 085 kWh/m²/rok" Foreground="#666666" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="Certifikováno dle RETScreen v2" FontWeight="Bold" Foreground="#2E7D32" FontSize="11" />
                            </Border>
                            <Button Content="Přepočítat model" Background="#003366" Foreground="White" FontWeight="Bold" Padding="12,4" Click="BtnCalculate_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STŘED: RETScreen SPREADSHEET (DATA GRID S BAREVNÝMI BUŇKAMI) -->
                <Border Grid.Row="1" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="3">
                    <DataGrid x:Name="gridData" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All"
                              HeadersVisibility="Column" HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                              BorderThickness="0" SelectionMode="Single" SelectionUnit="Cell">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Měsíc" Binding="{Binding Month}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Teplota vzduchu (°C)" Binding="{Binding Temperature}" Width="140" />
                            <DataGridTextColumn Header="Relativní vlhkost (%)" Binding="{Binding Humidity}" Width="140" />
                            <DataGridTextColumn Header="GHI Ozáření (kWh/m²/d)" Binding="{Binding DailyGhi}" Width="160" />
                            <DataGridTextColumn Header="Rychlost větru (m/s)" Binding="{Binding WindSpeed}" Width="140" />
                            <DataGridTextColumn Header="Teplota půdy 1m (°C)" Binding="{Binding GroundTemp}" Width="140" />
                            <DataGridTextColumn Header="HDD (18.3°C)" Binding="{Binding HeatingDegreeDays}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="CDD (18.3°C)" Binding="{Binding CoolingDegreeDays}" Width="120" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- DOLE: NATIVNÍ GRAF KUMULATIVNÍCH TOKŮ A TORNADO GRAF (LiveCharts) -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Graf 1: Kumulativní peněžní toky (25 let) -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="3" Margin="0,0,3,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="RETScreen Cumulative Cash Flows Graph (25 let)" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,6" />
                            <lvc:CartesianChart x:Name="chartCashFlows" />
                        </DockPanel>
                    </Border>

                    <!-- Graf 2: Tornado Analýza Rizik (±20 %) -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="3" Margin="3,0,0,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="Tornado Citlivostní Analýza na NPV (±20 % parametrů)" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,6" />
                            <lvc:CartesianChart x:Name="chartTornado" />
                        </DockPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- ================= STATUSBAR ================= -->
        <StatusBar Grid.Row="2" Background="#003366">
            <StatusBarItem>
                <TextBlock Text="PŘIPRAVENO" Foreground="White" FontWeight="Bold" FontSize="10" />
            </StatusBarItem>
            <Separator Background="#336699" />
            <StatusBarItem>
                <TextBlock Text="Certifikovaná databáze: 10 187 komponent | 11 242 meteorologických stanic NASA POWER" Foreground="#E0E0E0" FontSize="10" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="AuraEnergy OS v2.0 - 1:1 Nativní C# WPF Replika" Foreground="#81C784" FontWeight="Bold" FontSize="10" Margin="0,0,10,0" />
            </StatusBarItem>
        </StatusBar>

    </Grid>
</fluent:RibbonWindow>
