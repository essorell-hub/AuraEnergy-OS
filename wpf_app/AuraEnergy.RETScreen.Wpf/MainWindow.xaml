<fluent:RibbonWindow x:Class="AuraEnergy.RETScreen.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fluent="urn:fluent-ribbon"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:AuraEnergy.RETScreen.Wpf"
        mc:Ignorable="d"
        Title="AuraEnergy RETScreen® Expert Suite 2026 - Clean Energy Decision Support [FULL VERSION 1.0]"
        Height="920" Width="1460"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ================= MS FLUENT RIBBON (1:1 RETScreen Ribbon) ================= -->
        <fluent:Ribbon Grid.Row="0">
            <!-- Quick Access Items -->
            <fluent:Ribbon.QuickAccessItems>
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=btnSave}" />
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=btnCalculate}" />
            </fluent:Ribbon.QuickAccessItems>

            <!-- Application Menu (File / Backstage) -->
            <fluent:Ribbon.Menu>
                <fluent:Backstage Header="Soubor">
                    <fluent:BackstageTabControl>
                        <fluent:BackstageTabItem Header="Informace o projektu">
                            <StackPanel Margin="20">
                                <TextBlock Text="AuraEnergy RETScreen Expert Desktop [FULL VERSION]" FontSize="20" FontWeight="Bold" Foreground="#003366" />
                                <TextBlock Text="Nativní Windows .NET 8 WPF edice s podporou .retx balíčků, 10 187 certifikovaných produktů, ESG a PNE sítí." Margin="0,5,0,20" />
                                <fluent:Button x:Name="btnOpenRetx" Header="Otevřít oficiální RETScreen soubor (.retx)" Click="BtnOpenRetx_Click" Width="320" HorizontalAlignment="Left">
                                    <fluent:Button.Icon>
                                        <iconPacks:PackIconMaterial Kind="FolderOpen" Width="20" Height="20" Foreground="#003366" />
                                    </fluent:Button.Icon>
                                </fluent:Button>
                                <fluent:Button x:Name="btnSaveRetx" Header="Uložit jako RETScreen projekt (.retx)" Click="BtnSaveRetx_Click" Width="320" HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <fluent:Button.Icon>
                                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="20" Height="20" Foreground="#003366" />
                                    </fluent:Button.Icon>
                                </fluent:Button>
                            </StackPanel>
                        </fluent:BackstageTabItem>
                    </fluent:BackstageTabControl>
                </fluent:Backstage>
            </fluent:Ribbon.Menu>

            <!-- TAB 1: FACILITY (LOKALITA) -->
            <fluent:RibbonTabItem Header="1. Lokalita (Facility)">
                <fluent:RibbonGroupBox Header="Správa areálu">
                    <fluent:Button Header="Nový Areál" Click="BtnNewFacility_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="Domain" Width="32" Height="32" Foreground="#005A9E" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button x:Name="btnSave" Header="Uložit" Click="BtnSave_Click">
                        <fluent:Button.Icon>
                            <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" Foreground="#107C10" />
                        </fluent:Button.Icon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="Klimatická data NASA">
                    <fluent:Button Header="Vyhledat Stanici" Click="BtnSearchStation_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="MapMarkerRadius" Width="32" Height="32" Foreground="#D83B01" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="Stáhnout NASA POWER" Click="BtnNasaPower_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="SatelliteVariant" Width="32" Height="32" Foreground="#0078D4" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 2: ENERGY (ENERGETICKÝ MODEL) -->
            <fluent:RibbonTabItem Header="2. Energie (Energy Model)">
                <fluent:RibbonGroupBox Header="Přidat OZE Subsystém">
                    <fluent:Button Header="Fotovoltaika (FVE)" Click="BtnAddPv_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="SolarPower" Width="32" Height="32" Foreground="#FF8C00" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="Tepelné čerpadlo" Click="BtnAddHp_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="HeatPump" Width="32" Height="32" Foreground="#E81123" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="Kogenerace CHP" Click="BtnAddChp_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="EngineOutline" Width="32" Height="32" Foreground="#E65100" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="Solární ohřev TUV" Click="BtnAddSolarThermal_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="WaterBoiler" Width="32" Height="32" Foreground="#B146C2" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="Databáze produktů (10 187)">
                    <fluent:Button Header="Procházet katalog" Click="BtnBrowseProducts_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="DatabaseSearch" Width="32" Height="32" Foreground="#005A9E" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 3: COST (NÁKLADY & ROZPOČET WBS) -->
            <fluent:RibbonTabItem Header="3. Náklady (Cost WBS)">
                <fluent:RibbonGroupBox Header="Položkový rozpočet">
                    <fluent:Button Header="Přejít na rozpočet" Click="BtnShowWbs_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="PlaylistPlus" Width="32" Height="32" Foreground="#0078D4" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 4: EMISSION (EMISE GHG) -->
            <fluent:RibbonTabItem Header="4. Emise (GHG Analysis)">
                <fluent:RibbonGroupBox Header="Kalkulace emisí">
                    <fluent:Button Header="Emisní faktor sítě ČR" Click="BtnGridEmission_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="Factory" Width="32" Height="32" Foreground="#7A7574" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="Ekologické ekvivalenty" Click="BtnGhgEquiv_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="Tree" Width="32" Height="32" Foreground="#107C10" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 5: FINANCIAL (FINANČNÍ ANALÝZA & RIZIKO) -->
            <fluent:RibbonTabItem Header="5. Finance &amp; Riziko (Financial &amp; Risk)">
                <fluent:RibbonGroupBox Header="Analýza návratnosti">
                    <fluent:Button x:Name="btnCalculate" Header="Přepočítat model (IRR / NPV)" Click="BtnCalculate_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="CashMultiple" Width="32" Height="32" Foreground="#107C10" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="Export Manažerský PDF" Click="BtnExportPdf_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="FilePdfBox" Width="32" Height="32" Foreground="#D83B01" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="Analýza rizik">
                    <fluent:Button Header="Tornado Chart (±20 %)" Click="BtnTornado_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="WeatherTornado" Width="32" Height="32" Foreground="#E81123" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 6: BENCHMARK & TOOLS -->
            <fluent:RibbonTabItem Header="6. Benchmark &amp; VEA">
                <fluent:RibbonGroupBox Header="Hodnocení EUI">
                    <fluent:Button Header="5-Star Rating" Click="BtnStarRating_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="StarCircle" Width="32" Height="32" Foreground="#FFBA08" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="Dekarbonizace 2030" Click="BtnDecarb2030_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="Target" Width="32" Height="32" Foreground="#0078D4" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- TAB 7: ČESKÉ ROZŠÍŘENÍ (AURA+) -->
            <fluent:RibbonTabItem Header="7. ČEPS, PNE &amp; Vodík (AuraEnergy+)">
                <fluent:RibbonGroupBox Header="Česká legislativa a sítě">
                    <fluent:Button Header="PNE 33 3430-1 &amp; SVR" Click="BtnShowGridArbitrage_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="TransmissionTower" Width="32" Height="32" Foreground="#2E7D32" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="Vodík &amp; Agri-PV" Click="BtnShowHydrogen_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="Molecule" Width="32" Height="32" Foreground="#004D40" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                    <fluent:Button Header="E-Mobility &amp; ESG" Click="BtnShowEsg_Click">
                        <fluent:Button.LargeIcon>
                            <iconPacks:PackIconMaterial Kind="CarElectric" Width="32" Height="32" Foreground="#4A148C" />
                        </fluent:Button.LargeIcon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>
        </fluent:Ribbon>

        <!-- ================= MAIN WORKSPACE (TREEVIEW + DYNAMIC VIEW SWITCHER + CHARTS) ================= -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEVÝ HIERARCHICKÝ STROM (RETScreen TreeView) -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#003366" Padding="8,6">
                        <TextBlock Text="PROJEKTOVÝ STROM A SUBSYSTÉMY" FontWeight="Bold" Foreground="White" FontSize="11" />
                    </Border>
                    <TreeView x:Name="treeProject" BorderThickness="0" Margin="4" SelectedItemChanged="TreeProject_SelectedItemChanged">
                        <TreeViewItem Header="Nemocnice s poliklinikou (Facility)" IsExpanded="True">
                            <TreeViewItem x:Name="itemClimate" Header="Lokalita a klima (Praha NASA POWER)" IsSelected="True" />
                            <TreeViewItem Header="Zatížení areálu (End-Use Loads)" IsExpanded="True">
                                <TreeViewItem Header="Osvětlení &amp; LPD" />
                                <TreeViewItem Header="Vytápění &amp; VZT" />
                                <TreeViewItem Header="Chlazení &amp; Klimatizace" />
                            </TreeViewItem>
                            <TreeViewItem Header="Navržená energetická soustava" IsExpanded="True">
                                <TreeViewItem x:Name="itemPv" Header="FVE Elektrárna (monoSi 250 kWp)" />
                                <TreeViewItem x:Name="itemHp" Header="Tepelné čerpadlo (Země-Voda 120 kWt)" />
                                <TreeViewItem x:Name="itemChp" Header="Kogenerace CHP &amp; Solární termika" />
                                <TreeViewItem x:Name="itemHydrogen" Header="Zelený vodík &amp; Agrofotovoltaika" />
                                <TreeViewItem x:Name="itemEsg" Header="Firemní E-Mobility &amp; ESG Audit" />
                                <TreeViewItem x:Name="itemGrid" Header="Připojení k síti PNE &amp; Arbitráž OTE" />
                                <TreeViewItem Header="BESS Bateriové úložiště (300 kWh)" />
                            </TreeViewItem>
                            <TreeViewItem x:Name="itemWbs" Header="Položkový rozpočet (WBS CAPEX)" />
                            <TreeViewItem Header="Emisní bilance skleníkových plynů" />
                            <TreeViewItem Header="Finanční model (25leté cash flows)" />
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0" />

            <!-- HLAVNÍ PRACOVNÍ PLOCHA (Tabulkový procesor + Grafy) -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="260" />
                </Grid.RowDefinitions>

                <!-- HEADER LIŠTA ZVOLENÉHO FORMULÁŘE -->
                <Border Grid.Row="0" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" Padding="12,8" Margin="0,0,0,6" CornerRadius="3">
                    <Grid>
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="txtViewTitle" Text="Lokalita a klimatická data NASA POWER" FontSize="14" FontWeight="Bold" Foreground="#003366" />
                            <TextBlock x:Name="txtViewSubtitle" Text="Stanice: Praha / Ruzyne (50.08° N, 14.43° E, 230 m n.m.) | Globální horizontální ozáření GHI: 1 085 kWh/m²/rok" Foreground="#666666" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="Certifikováno dle RETScreen v2" FontWeight="Bold" Foreground="#2E7D32" FontSize="11" />
                            </Border>
                            <Button Content="Přepočítat model" Background="#003366" Foreground="White" FontWeight="Bold" Padding="12,4" Click="BtnCalculate_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STŘED: DYNAMICKÝ KONTEJNER PRO ZVOLENÉ ZOBRAZENÍ -->
                <Grid Grid.Row="1">
                    <!-- VIEW 1: KLIMATICKÁ TABULKA -->
                    <Border x:Name="viewClimate" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="3" Visibility="Visible">
                        <DataGrid x:Name="gridData" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All"
                                  HeadersVisibility="Column" HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                                  BorderThickness="0" SelectionMode="Single" SelectionUnit="Cell">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Měsíc" Binding="{Binding Month}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Teplota vzduchu (°C)" Binding="{Binding Temperature}" Width="140" />
                                <DataGridTextColumn Header="Relativní vlhkost (%)" Binding="{Binding Humidity}" Width="140" />
                                <DataGridTextColumn Header="GHI Ozáření (kWh/m²/d)" Binding="{Binding DailyGhi}" Width="160" />
                                <DataGridTextColumn Header="Rychlost větru (m/s)" Binding="{Binding WindSpeed}" Width="140" />
                                <DataGridTextColumn Header="Teplota půdy 1m (°C)" Binding="{Binding GroundTemp}" Width="140" />
                                <DataGridTextColumn Header="HDD (18.3°C)" Binding="{Binding HeatingDegreeDays}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="CDD (18.3°C)" Binding="{Binding CoolingDegreeDays}" Width="120" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- VIEW 2: FVE SUBSYSTÉM -->
                    <local:PvSystemView x:Name="viewPv" Visibility="Collapsed" />

                    <!-- VIEW 3: TEPELNÉ ČERPADLO SUBSYSTÉM -->
                    <local:HeatPumpView x:Name="viewHp" Visibility="Collapsed" />

                    <!-- VIEW 4: KOGENERACE CHP & TERMICKÝ OHŘEV -->
                    <local:ChpSolarThermalView x:Name="viewChp" Visibility="Collapsed" />

                    <!-- VIEW 5: WBS ROZPOČET -->
                    <local:CostWbsView x:Name="viewWbs" Visibility="Collapsed" />

                    <!-- VIEW 6: PNE 33 3430-1 & ARBITRÁŽ (AURA+) -->
                    <local:CzechGridArbitrageView x:Name="viewGridArbitrage" Visibility="Collapsed" />

                    <!-- VIEW 7: VODÍK & AGRI-PV -->
                    <local:HydrogenAgriPvView x:Name="viewHydrogen" Visibility="Collapsed" />

                    <!-- VIEW 8: E-MOBILITY & ESG AUDIT -->
                    <local:EsgEmobilityView x:Name="viewEsg" Visibility="Collapsed" />
                </Grid>

                <!-- DOLE: NATIVNÍ GRAF KUMULATIVNÍCH TOKŮ A TORNADO GRAF (LiveCharts) -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Graf 1: Kumulativní peněžní toky (25 let) -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="3" Margin="0,0,3,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="RETScreen Cumulative Cash Flows Graph (25 let)" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,4" />
                            <lvc:CartesianChart x:Name="chartCashFlows" />
                        </DockPanel>
                    </Border>

                    <!-- Graf 2: Tornado Analýza Rizik (±20 %) -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="3" Margin="3,0,0,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="Tornado Citlivostní Analýza na NPV (±20 % parametrů)" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,4" />
                            <lvc:CartesianChart x:Name="chartTornado" />
                        </DockPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- ================= STATUSBAR ================= -->
        <StatusBar Grid.Row="2" Background="#003366">
            <StatusBarItem>
                <TextBlock Text="PŘIPRAVENO" Foreground="White" FontWeight="Bold" FontSize="10" />
            </StatusBarItem>
            <Separator Background="#336699" />
            <StatusBarItem>
                <TextBlock Text="Certifikovaná databáze: 10 187 komponent | 11 242 meteorologických stanic NASA POWER" Foreground="#E0E0E0" FontSize="10" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="AuraEnergy OS v2.0 - 1:1 Nativní C# WPF Replika [FULL EDITION]" Foreground="#81C784" FontWeight="Bold" FontSize="10" Margin="0,0,10,0" />
            </StatusBarItem>
        </StatusBar>

    </Grid>
</fluent:RibbonWindow>
